# Copy to .env.local to override. Never put secrets here: every VITE_ value is
# compiled into the public browser bundle.

# Base path of the REST API. The default works with the dev proxy in vite.config.ts.
VITE_API_BASE_URL=/api/v1

# "true" serves the app from the in-browser mock backend (no Spring Boot needed).
# Must be "false" or unset for any real environment.
VITE_API_MOCK=false
